{
  "appId": "com.kuanwei.admin",
  "appName": "物流筐管理",
  "webDir": "www",
  "server": {
    "url": "https://inventory-app-9ql.pages.dev/admin-panel.html",
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#082E38",
